---
import "@/styles/theme.css";

import AnniversaryTable from "@/components/AnniversaryTable.astro";
import UpcomingBanner from "@/components/UpcomingBanner.astro";
import { buildSchedule, findUpcoming, toFiscalYear } from "@/lib/anniversary";
import { formatUpcoming }from "@/utils/format-upcoming"
import { Temporal } from "@js-temporal/polyfill";

const today = Temporal.Now.plainDateISO("Asia/Tokyo");
const currentYear = toFiscalYear(today);
const rows = buildSchedule(today);
const upcoming = findUpcoming(rows, currentYear);

const title = "東京ディズニーリゾート アニバーサリー早見表";
const description = `東京ディズニーランドとディズニーシーの開園日およびアニバーサリーの一覧表。${formatUpcoming(upcoming)}。`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

/** 最終更新日(ビルド日)。例: 2026年11月16日 */
const updatedAt = `${today.year}年${today.month}月${today.day}日`;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={title} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content="ja_JP" />
		<meta property="article:modified_time" content={today.toString()} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<link rel="sitemap" href="/sitemap-index.xml" />
	</head>
	<body>
		<main>
			<h1>{title}</h1>
			<UpcomingBanner upcoming={upcoming} />
			<AnniversaryTable rows={rows} currentYear={currentYear} />
			<section class="notes" aria-label="注意事項">
				<p>
					※「予定」と記載されている内容は計算上の予測日であり、公式に発表された確定情報ではありません。
				</p>
				<p>
					当サイトは個人が運営する非公式のファンサイトです。ディズニー・エンタプライゼズ・インク、株式会社オリエンタルランドとは一切の関わりはありません。
				</p>
			</section>
		</main>
		<footer>
			<p class="updated">
				最終更新日: <time datetime={today.toString()}>{updatedAt}</time>
			</p>
			<address>
				<span>© {today.year} </span>
				<a href="https://ryohidaka.jp/" rel="author">ryohidaka.jp</a>
			</address>
		</footer>
	</body>
</html>

<style>
	main {
		max-width: 32rem;
		margin: 0 auto;
	}

	h1 {
		font-size: 1.25rem;
		text-align: center;
	}

	.notes {
		margin-top: 1rem;
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	.notes p {
		margin: 0 0 0.5rem;
	}

	footer {
		padding: 0.75rem 0;
		text-align: center;
	}

	.updated {
		margin: 0 0 0.25rem;
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	address {
		font-size: 0.875rem;
		font-style: normal;
	}

	address a {
		color: var(--link);
	}
</style>