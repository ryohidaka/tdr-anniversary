---
import type { YearRow } from "@/lib/anniversary";

interface Props {
	rows: YearRow[];
	/** 現在の年度。この年度の行を強調し、これより先の年度のセルは予測として表示する */
	currentYear: number;
}

const { rows, currentYear } = Astro.props;

const eraFormatter = new Intl.DateTimeFormat("ja-JP-u-ca-japanese", {
	era: "long",
	year: "numeric",
});

/** 年度(4月始まり)の初日を基準に和暦へ変換する。例: 2026 → 令和8年 */
function formatEra(fiscalYear: number): string {
	return eraFormatter.format(new Date(fiscalYear, 3, 1));
}

/**
 * セルの表示内容を返す。
 * 0周年は「オープン」、節目でなければ「-」。
 * 現在の年度より先の節目は、開園日からの計算による予測(公式発表ではない)として
 * projected = true にする。
 */
function toCell(n: number | null, year: number) {
	if (n === null) return { label: "-", projected: false };
	return {
		label: n === 0 ? "オープン" : `${n}周年`,
		projected: year > currentYear,
	};
}
---

<table>
	<thead>
		<tr>
			<th scope="col">年度</th>
			<th scope="col" class="land">ディズニーランド</th>
			<th scope="col" class="sea">ディズニーシー</th>
		</tr>
	</thead>
	<tbody>
		{
			rows.map((row) => {
				const land = toCell(row.land, row.year);
				const sea = toCell(row.sea, row.year);
				return (
					<tr
						class:list={{ current: row.year === currentYear }}
						aria-current={row.year === currentYear ? "true" : undefined}
					>
						<th scope="row">
							<span>{row.year}</span>
							<span class="era">{formatEra(row.year)}</span>
						</th>
						<td class:list={["land", { filled: row.land !== null }]}>
							<span>{land.label}</span>
							{land.projected && <span class="projected">（予定）</span>}
						</td>
						<td class:list={["sea", { filled: row.sea !== null }]}>
							<span>{sea.label}</span>
							{sea.projected && <span class="projected">（予定）</span>}
						</td>
					</tr>
				);
			})
		}
	</tbody>
</table>

<style>
	table {
		--color-land: #db2777;
		--color-sea: #2563eb;

		width: 100%;
		border-collapse: collapse;
	}

	th,
	td {
		padding: 0.5rem 0.75rem;
		border: 1px solid #d1d5db;
		text-align: center;
		white-space: nowrap;
	}

	thead th {
		position: sticky;
		top: 0;
		z-index: 1;
		background: #cbd5e1;
	}

	thead .land,
	thead .sea {
		color: #fff;
	}

	thead .land {
		background: var(--color-land);
	}

	thead .sea {
		background: var(--color-sea);
	}

	tbody th {
		font-weight: normal;
	}

	/* 和暦と予測は、本文の下に小さく表示する */
	.era,
	.projected {
		display: block;
		font-size: 0.75rem;
		color: #737373;
	}

	/* 今年度の行は、年度セルと値のあるセルを含めてすべて塗る(パーク色より優先) */
	tbody tr.current > * {
		background: var(--color-yellow-200, #fef08a);
	}

	/* 値のあるセルはパークの色。今年度の行は対象外 */
	tbody tr:not(.current) td.land.filled {
		background: var(--color-red-200, #fecaca);
	}

	tbody tr:not(.current) td.sea.filled {
		background: var(--color-blue-200, #bfdbfe);
	}

	@media (min-width: 768px) {
		table {
			font-size: 1rem;
		}
	}
</style>