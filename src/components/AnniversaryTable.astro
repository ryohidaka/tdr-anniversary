---
import { getDictionary, type Locale } from "@/i18n";
import { isProjected, type YearRow } from "@/lib/anniversary";
import { formatAnniversary } from "@/utils/format-anniversary";
import { formatEra } from "@/utils/format-era";

interface Props {
	rows: YearRow[];
	/** 現在の年度。この年度の行を強調し、これより先の年度のセルは予測として表示する */
	currentYear: number;
	locale: Locale;
}

const { rows, currentYear, locale } = Astro.props;
const t = getDictionary(locale);

/** セルの表示内容。節目のセルのうち、現在の年度より先のものは予測として表示する */
function toCell(n: number | null, year: number) {
	return {
		label: formatAnniversary(n, t),
		projected: n !== null && isProjected(year, currentYear),
	};
}
---

<table>
	<caption class="sr-only">{t.table.caption}</caption>
	<thead>
		<tr>
			<th scope="col">{t.table.fiscalYear}</th>
			<th scope="col" class="land">{t.parks.land}</th>
			<th scope="col" class="sea">{t.parks.sea}</th>
		</tr>
	</thead>
	<tbody>
		{
			rows.map((row) => {
				const land = toCell(row.land, row.year);
				const sea = toCell(row.sea, row.year);
				return (
					<tr
						class:list={{ current: row.year === currentYear }}
						aria-current={row.year === currentYear ? "true" : undefined}
					>
						<th scope="row">
							<span>{row.year}</span>
							{t.showEra && <span class="era">{formatEra(row.year)}</span>}
						</th>
						<td class:list={["land", { filled: row.land !== null }]}>
							<span>{land.label}</span>
							{land.projected && <span class="projected">{t.table.projected}</span>}
						</td>
						<td class:list={["sea", { filled: row.sea !== null }]}>
							<span>{sea.label}</span>
							{sea.projected && <span class="projected">{t.table.projected}</span>}
						</td>
					</tr>
				);
			})
		}
	</tbody>
</table>

<style>
	table {
		width: 100%;
		border-collapse: collapse;
	}

	/* 視覚的には隠し、スクリーンリーダーとエージェントには表の説明として渡す */
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	th,
	td {
		padding: 0.5rem 0.75rem;
		border: 1px solid var(--border);
		text-align: center;
		white-space: nowrap;
	}

	thead th {
		position: sticky;
		top: 0;
		z-index: 1;
		background: var(--table-head-bg);
	}

	thead .land,
	thead .sea {
		color: #fff;
	}

	thead .land {
		background: var(--park-land);
	}

	thead .sea {
		background: var(--park-sea);
	}

	tbody th {
		font-weight: normal;
	}

	/* 和暦と予測は、本文の下に小さく表示する */
	.era,
	.projected {
		display: block;
		font-size: 0.75rem;
		color: var(--text-subtle);
	}

	/* 今年度の行は、年度セルと値のあるセルを含めてすべて塗る(パーク色より優先) */
	tbody tr.current > * {
		background: var(--row-current);
	}

	/* 値のあるセルはパークの色。今年度の行は対象外 */
	tbody tr:not(.current) td.land.filled {
		background: var(--cell-land);
	}

	tbody tr:not(.current) td.sea.filled {
		background: var(--cell-sea);
	}

	@media (min-width: 768px) {
		table {
			font-size: 1rem;
		}
	}
</style>