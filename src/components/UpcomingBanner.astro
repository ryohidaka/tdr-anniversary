---
import type { UpcomingAnniversary } from "@/lib/anniversary";
import { formatUpcoming } from "@/utils/format-upcoming";

interface Props {
	upcoming: UpcomingAnniversary;
}

const message = formatUpcoming(Astro.props.upcoming);
---

<p class="banner">{message}</p>

<style>
	.banner {
		margin: 1rem 0;
		padding: 0.75rem 1rem;
		border: 1px solid var(--border);
		background: var(--surface);
		text-align: center;
	}
</style>